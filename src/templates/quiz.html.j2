<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:;">
<title>{{ blueprint.title }}</title><style>
:root{--p:#6558d3;--ink:#24314d;--line:#dbe3f2;--good:#087453;--bad:#b3261e}*{box-sizing:border-box}body{margin:0;font:16px/1.5 system-ui;color:var(--ink);background:#f5f7ff}header{background:linear-gradient(135deg,#6558d3,#8b5cf6);color:#fff;text-align:center;padding:28px}main{max-width:980px;margin:auto;padding:18px}.card,.q{background:#fff;border:1px solid var(--line);border-radius:18px;padding:18px;margin:12px 0}.pattern{display:grid;grid-template-columns:1fr auto;gap:8px}.section{margin-top:28px;padding:10px 14px;background:#eceeff;border-radius:12px}.options{display:grid;grid-template-columns:1fr 1fr;gap:8px}.options label{padding:10px;border:1px solid var(--line);border-radius:10px}input[type=text]{padding:10px;border:2px solid var(--line);border-radius:10px;min-width:260px}button{border:0;border-radius:12px;padding:11px 16px;background:var(--p);color:#fff;font-weight:750;cursor:pointer}.feedback{font-weight:700;margin-top:8px}.progress{height:12px;background:#e5e9f4;border-radius:9px;overflow:hidden}.progress div{height:100%;background:#20a57a;width:0}.student{display:flex;gap:24px;flex-wrap:wrap}.manual{color:#8a5a00}.result{font-size:1.25rem;font-weight:800}@media(max-width:650px){.options{grid-template-columns:1fr}}@media print{header button,.actions,.feedback,.result,.progress{display:none!important}body{background:#fff;color:#111}.q,.card{break-inside:avoid;box-shadow:none}.answer-input{border:0;border-bottom:1px solid #222;border-radius:0}.teacher-only{display:none}}
</style></head><body><header><h1>🧠 {{ blueprint.title }}</h1><p>{{ questions|length }} questions • {{ blueprint.total_marks }} marks • {{ blueprint.duration_minutes }} minutes</p><button onclick="window.print()">Print student paper</button></header><main><section class="card"><div class="student"><span>Name: __________________</span><span>Date: __________</span><span>Class: __________</span></div><h2>Question Paper Pattern</h2><div class="pattern">{% for s in blueprint.sections %}<span>{{ loop.index }}. {{ s.title }}</span><b>{{ s.question_count }} questions • {{ s.section_marks }} marks</b>{% endfor %}</div><p>{{ blueprint.instructions }}</p><div class="progress"><div id="bar"></div></div><small id="status">0 of {{ questions|length }} answered</small></section><form id="paper">
{% for s in blueprint.sections %}<h2 class="section">{{ loop.index }}. {{ s.title }} — {{ s.section_marks }} marks</h2>{% for q in questions if q.section_id==s.section_id %}<article class="q" data-id="{{ q.question_id }}"><b>{{ q.question_id }}. {{ q.prompt }}</b> <small>({{ q.marks }} mark{% if q.marks != 1 %}s{% endif %})</small>{% if q.manual_review_required %}<p class="manual">✍ Parent/Teacher Review</p><textarea aria-label="Answer {{ q.question_id }}" rows="4" style="width:100%"></textarea>{% elif q.options %}<div class="options">{% for o in q.options %}<label><input type="radio" name="{{ q.question_id }}" value="{{ o }}"> {{ o }}</label>{% endfor %}</div>{% else %}<p><label>Answer <input class="answer-input" aria-label="Answer {{ q.question_id }}" type="text"></label></p>{% endif %}<div class="feedback"></div></article>{% endfor %}{% endfor %}</form><div class="actions"><button onclick="score()">Finish & check score</button> <button onclick="fresh()">Try again with new questions</button></div><p class="result" id="result"></p></main>
<script>const questions={{ question_json|safe }},norm=s=>String(s||'').toLowerCase().replace(/[\s,.-]/g,'');document.getElementById('paper').addEventListener('input',progress);function val(q){const c=document.querySelector(`[data-id="${q.question_id}"]`);if(q.manual_review_required)return c.querySelector('textarea').value;const r=c.querySelector('input:checked');return r?r.value:(c.querySelector('input[type=text]')||{}).value||''}function progress(){const n=questions.filter(q=>val(q)).length;document.getElementById('status').textContent=`${n} of ${questions.length} answered`;document.getElementById('bar').style.width=`${n/questions.length*100}%`}function score(){let n=0,total=0;questions.forEach(q=>{const c=document.querySelector(`[data-id="${q.question_id}"]`),f=c.querySelector('.feedback');if(q.manual_review_required){f.textContent='Saved for Parent/Teacher Review';return}total++;const ok=norm(val(q))===norm(q.canonical_answer)||q.alternate_answers.some(a=>norm(a)===norm(val(q)));if(ok)n++;f.textContent=ok?'✓ Correct!':`Try again. Hint: ${q.hint}`;f.style.color=ok?'#087453':'#b3261e'});document.getElementById('result').textContent=`Great effort! ${n} of ${total} automatically scored answers are correct.`}function fresh(){const u=new URL(location.href);location.reload()} </script></body></html>
