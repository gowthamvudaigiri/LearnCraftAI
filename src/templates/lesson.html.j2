<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:;">
<title>{{ lesson.title }}</title><style>
:root{--p:#6558d3;--s:#20a57a;--ink:#24314d;--paper:#fff;--bg:#f3f5ff}*{box-sizing:border-box}body{margin:0;font:17px/1.6 system-ui;color:var(--ink);background:var(--bg)}header{padding:38px 20px;color:white;text-align:center;background:linear-gradient(135deg,#6558d3,#8b5cf6)}main{max-width:960px;margin:-18px auto 50px;padding:0 16px}.card{background:var(--paper);border-radius:22px;padding:24px;margin:18px 0;box-shadow:0 12px 32px #29376b1c}.pill{display:inline-block;padding:5px 11px;border-radius:999px;background:#e8fff6;color:#087453;font-weight:700}.example,.practice,.mistake{padding:14px;border-radius:14px;margin:12px 0}.example{background:#eef0ff}.practice{background:#fff7d6}.mistake{background:#fff0f0}button{border:0;border-radius:12px;padding:10px 15px;background:var(--p);color:white;font-weight:700;cursor:pointer}.answer{display:none;margin-top:8px;color:#087453;font-weight:700}.progress{position:sticky;top:0;background:#fff;padding:10px;text-align:center;z-index:2}@media print{button,.progress{display:none}.card{box-shadow:none;border:1px solid #ccc;break-inside:avoid}body{background:#fff;color:#111}header{background:#fff;color:#111;border-bottom:2px solid #222}}
</style></head><body><header><h1>🌟 {{ lesson.title }}</h1><p>Learn • Try • Check • Grow</p></header><div class="progress"><span id="done">0</span> / {{ lesson.sections|length }} concepts explored</div><main>
{% for s in lesson.sections %}<section class="card"><span class="pill">Concept {{ loop.index }}</span><h2>{{ s.title }}</h2><h3>What you will learn</h3><p>{{ s.objective }}</p><p>{{ s.explanation }}</p><div class="example"><b>Worked example</b>{% for e in s.worked_examples %}<p>{{ e }}</p>{% endfor %}<p>🖍️ {{ s.visual }}</p></div><div class="mistake"><b>Watch out</b><p>{{ s.common_mistake }}</p></div><div class="practice"><b>Guided practice</b><p>{{ s.guided_practice }}</p><small>Hint: {{ s.hint }}</small><hr><b>Quick check:</b> {{ s.quick_check }}<br><button onclick="this.nextElementSibling.style.display='block';mark('{{ loop.index }}')">Check answer</button><div class="answer">{{ s.answer }}</div></div></section>{% endfor %}</main>
<script>const key='kids-studio-{{ document_id }}',seen=new Set(JSON.parse(localStorage.getItem(key)||'[]'));function mark(i){seen.add(i);localStorage.setItem(key,JSON.stringify([...seen]));document.getElementById('done').textContent=seen.size}document.getElementById('done').textContent=seen.size;</script></body></html>
